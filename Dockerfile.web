# syntax=docker/dockerfile:1
# Heimdallone v2 — web app image (TanStack Start SSR via Nitro).
# `bun run build` produces a self-contained .output/ (Nitro bundles its own
# runtime deps), so the runtime stage ships only .output/ + a JS runtime.
# Runs as non-root.
ARG BUN_VERSION=1.3.12

FROM oven/bun:${BUN_VERSION}-slim AS base
WORKDIR /app
ENV HUSKY=0

# ── build: install + build the web app to .output (Nitro node-server) ────────
FROM base AS build
ENV NODE_ENV=production
# node-server preset → a self-hostable .output/server/index.mjs.
ENV NITRO_PRESET=bun
# Manifests first so the dependency-install layer caches across source-only edits.
COPY --parents package.json bun.lock turbo.json apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY . .
RUN bun run --filter=web build

# ── runtime: Alpine (musl). Safe here because the runtime is the self-contained
# Nitro .output (pure JS) + Bun — the native build tools (tailwind oxide,
# lightningcss) run only in the glibc build stage above, never at runtime. Alpine
# drops the base from ~275 MB (bun-slim) to ~80 MB. Proven via smoke test.
FROM oven/bun:${BUN_VERSION}-alpine AS runtime
WORKDIR /app
LABEL org.opencontainers.image.title="Heimdallone v2 web" \
      org.opencontainers.image.source="https://github.com/kareemschultz/heimdallone-v2" \
      org.opencontainers.image.description="Heimdallone v2 web app (TanStack Start SSR on Nitro)"
ENV NODE_ENV=production
# CA certs for outbound TLS (alpine omits them; ICU for timezones ships with Bun).
RUN apk add --no-cache ca-certificates
# Nitro Bun-preset output is self-contained (deps inlined) — no node_modules at
# runtime. Entry is .output/server/index.mjs (see .output/nitro.json).
COPY --from=build /app/apps/web/.output ./.output
USER bun
ENV PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["bun", ".output/server/index.mjs"]
