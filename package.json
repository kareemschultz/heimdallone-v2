{
  "name": "Heimdallone",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/bun": "^1.3.4",
      "hono": "^4.8.2",
      "@orpc/server": "^1.13.14",
      "@orpc/openapi": "^1.13.14",
      "@orpc/zod": "^1.13.14",
      "better-auth": "1.6.11",
      "evlog": "^2.14.1",
      "next-themes": "^0.4.6",
      "@orpc/tanstack-query": "^1.13.14",
      "@orpc/client": "^1.13.14",
      "@tanstack/react-form": "^1.28.0",
      "@types/react-dom": "^19.2.3",
      "@better-auth/expo": "1.6.11"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @Heimdallone/db db:push",
    "db:studio": "turbo -F @Heimdallone/db db:studio",
    "db:generate": "turbo -F @Heimdallone/db db:generate",
    "db:migrate": "turbo -F @Heimdallone/db db:migrate",
    "db:start": "turbo -F @Heimdallone/db db:start",
    "db:watch": "turbo -F @Heimdallone/db db:watch",
    "db:stop": "turbo -F @Heimdallone/db db:stop",
    "db:down": "turbo -F @Heimdallone/db db:down",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "audit:permissions": "bun scripts/audit-permissions.ts",
    "verify:pay-frequency": "bun scripts/verify-pay-frequency.ts",
    "verify:roster": "bun scripts/verify-roster-api.ts",
    "verify:gl": "bun scripts/verify-gl-api.ts",
    "verify:notifications": "bun scripts/verify-notifications-api.ts",
    "verify:payroll-resolver": "bun scripts/verify-payroll-resolver.ts",
    "verify:leave-resolver": "bun scripts/verify-leave-resolver.ts",
    "verify:db": "bun scripts/verify-performance-db.ts && bun scripts/verify-crm-db.ts && bun scripts/verify-finance-db.ts",
    "verify:core": "bun run audit:permissions && bun run verify:pay-frequency && bun run verify:roster && bun run verify:gl && bun run verify:notifications && bun run verify:payroll-resolver && bun run verify:leave-resolver && bun run verify:db",
    "migration:dry-run": "bun run scripts/migration/run-dry-run.ts",
    "migration:reconcile": "bun run scripts/migration/run-reconciliation.ts",
    "migration:write-etl": "bun run scripts/migration/write-etl/run-write-etl.ts",
    "migration:test-transformers": "bun test scripts/migration/write-etl/transformers.test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@Heimdallone/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Heimdallone/config": "workspace:*",
    "@biomejs/biome": "2.4.15",
    "@paralleldrive/cuid2": "^3.3.0",
    "@types/bun": "catalog:",
    "drizzle-orm": "^0.45.2",
    "husky": "latest",
    "lefthook": "latest",
    "pg": "^8.17.1",
    "@types/pg": "^8.16.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.8.0"
  },
  "packageManager": "bun@1.3.12"
}
