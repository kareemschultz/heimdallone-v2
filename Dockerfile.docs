# syntax=docker/dockerfile:1
# Heimdallone v2 — Fumadocs site image (TanStack Start SSR via Nitro).
# Built with NITRO_PRESET=node-server (vite.config defaults to "vercel"); the
# self-contained .output/ is the only runtime artifact. Optional service —
# docs are not required for app cutover. Runs as non-root.
ARG BUN_VERSION=1.3.12

FROM oven/bun:${BUN_VERSION}-slim AS base
WORKDIR /app
ENV HUSKY=0

FROM base AS build
ENV NODE_ENV=production
ENV NITRO_PRESET=bun
# Manifests first so the dependency-install layer caches across source-only edits.
COPY --parents package.json bun.lock turbo.json apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY . .
RUN bun run --filter=docs build

FROM base AS runtime
LABEL org.opencontainers.image.title="Heimdallone v2 docs" \
      org.opencontainers.image.source="https://github.com/kareemschultz/heimdallone-v2" \
      org.opencontainers.image.description="Heimdallone v2 documentation (Fumadocs on Nitro)"
ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/apps/docs/.output ./.output
USER bun
ENV PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["bun", ".output/server/index.mjs"]
