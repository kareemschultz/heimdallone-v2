# ─────────────────────────────────────────────────────────────────────────────
# Heimdallone — environment template. Copy the relevant block into each app's
# own .env (apps/server/.env, apps/web/.env) and this root .env (dev tooling).
# All values are validated at boot via packages/env (server.ts / web.ts).
# NEVER commit real secrets — this repo only commits .env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ── apps/server/.env ──────────────────────────────────────────────────────────
# Postgres connection string (Drizzle ORM).
DATABASE_URL=postgres://user:password@localhost:5432/heimdallone
# Better Auth signing secret — generate a long random value (openssl rand -hex 32).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL the auth server is reached at (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Allowed browser origin for CORS + trusted origins (the web app URL).
CORS_ORIGIN=http://localhost:3002

# ── apps/web/.env ─────────────────────────────────────────────────────────────
# URL of the oRPC/auth server the web client calls.
VITE_SERVER_URL=http://localhost:3000

# ── root .env (dev tooling only — shadcn/studio Pro CLI + MCP) ─────────────────
# Retrieve from Infisical /credentials/shadcnstudio/. Not needed at runtime.
EMAIL=your-email@example.com
LICENSE_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
