# Heimdallone v2 Device Bridge — environment variables
# Copy to .env on the Pi and fill in real values before running.
# These three secret/identity values live ONLY on the Pi — never in the Gist,
# never committed.

# Required — v2
HEIMDALL_API_URL=https://app.heimdallone.com
HEIMDALL_DEVICE_ID=the-v2-attendance_device-row-id-from-registration
HEIMDALL_API_KEY=the-v2-ingest-key-shown-ONCE-at-registration
HEIMDALL_DEVICE_IP=10.241.1.109

# Optional — defaults shown
HEIMDALL_DEVICE_PORT=4370
HEIMDALL_POLL_INTERVAL=60
HEIMDALL_BATCH_SIZE=500            # server caps at 5000
HEIMDALL_CURSOR_PATH=./cursor.json
HEIMDALL_SYNC_DEVICE_TIME=true     # overwrite terminal clock with UTC each poll
HEIMDALL_DISABLE_DURING_FETCH=true # briefly disable terminal while reading log
HEIMDALL_DEVICE_TIMEOUT=30
HEIMDALL_DEVICE_PASSWORD=0         # numeric device password (0 = none)
HEIMDALL_VERIFY_MODE=fingerprint   # reported method: fingerprint|face|card|password|mobile_gps|manual|unknown

# Clock-drift auto-correction (the one genuine fix carried from v1).
# Detects punches 3-5h behind UTC (terminal reverted to GYT after a power cut)
# and shifts them +4h before upload. Set CORRECT=false to log-only.
HEIMDALL_CLOCK_DRIFT_CORRECT=true
HEIMDALL_CLOCK_DRIFT_MIN_HOURS=3
HEIMDALL_CLOCK_DRIFT_MAX_HOURS=5

# Optional Telegram alert when corrections are applied (unset = journald only).
HEIMDALL_TELEGRAM_BOT_TOKEN=
HEIMDALL_TELEGRAM_CHAT_ID=
