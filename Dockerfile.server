# syntax=docker/dockerfile:1
# Heimdallone v2 — API/server image.
# Built as a single self-contained Bun executable (bun build --compile), so the
# runtime image carries NO node_modules and NO source — just the binary on a
# minimal glibc base with TLS certs. Smallest image that still runs Bun + TLS +
# ICU timezones + the node-postgres driver reliably. Runs as non-root.
ARG BUN_VERSION=1.3.12

# ── build: install (frozen) + compile to a standalone binary ─────────────────
FROM oven/bun:${BUN_VERSION}-slim AS build
WORKDIR /app
ENV HUSKY=0
ENV NODE_ENV=production
# Manifests first so the dependency-install layer caches across source-only edits.
COPY --parents package.json bun.lock turbo.json apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts
# Then the source (install layer above stays cached unless a manifest/lockfile changes).
COPY . .
WORKDIR /app/apps/server
# --compile bundles the @Heimdallone/* workspace code AND every npm dependency
# (drizzle-orm, node-postgres, better-auth, @orpc, hono, …) plus the Bun runtime
# into one executable. --minify for size; no sourcemaps in the runtime.
RUN bun build --compile --minify ./src/index.ts --outfile /tmp/heimdallone-server

# ── runtime: minimal Debian + TLS certs only, non-root ───────────────────────
FROM debian:trixie-slim AS runtime
LABEL org.opencontainers.image.title="Heimdallone v2 server" \
      org.opencontainers.image.source="https://github.com/kareemschultz/heimdallone-v2" \
      org.opencontainers.image.description="Heimdallone v2 API/server (oRPC + Hono on Bun, compiled)"
# ca-certificates: outbound TLS (OAuth/email/Stripe). curl: container healthcheck.
# ca-certificates: outbound TLS. curl: healthcheck. libstdc++6: the compiled Bun
# binary links against it on a bare Debian base.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl libstdc++6 \
  && rm -rf /var/lib/apt/lists/* \
  && useradd -r -u 1000 -m -s /usr/sbin/nologin app
COPY --from=build /tmp/heimdallone-server /usr/local/bin/heimdallone-server
USER app
ENV PORT=3000 NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-3000}/health" || exit 1
CMD ["heimdallone-server"]
