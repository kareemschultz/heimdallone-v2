# syntax=docker/dockerfile:1
# Heimdallone v2 — API/server image.
# Built as a single self-contained Bun executable (bun build --compile), shipped on
# distroless/cc (glibc + libgcc + libstdc++ + ca-certificates, no OS/shell). Smallest
# safe image that runs the glibc-linked Bun binary with working TLS + ICU timezones
# + node-postgres. Non-root. No node_modules, no source, no shell.
ARG BUN_VERSION=1.3.12

# ── build: install (frozen) + compile to a standalone binary ─────────────────
FROM oven/bun:${BUN_VERSION}-slim AS build
WORKDIR /app
ENV HUSKY=0
ENV NODE_ENV=production
# Manifests first so the dependency-install layer caches across source-only edits.
COPY --parents package.json bun.lock turbo.json apps/*/package.json packages/*/package.json ./
RUN bun install --frozen-lockfile --ignore-scripts
# Then the source (install layer above stays cached unless a manifest/lockfile changes).
COPY . .
WORKDIR /app/apps/server
# --compile bundles the @Heimdallone/* workspace code AND every npm dependency
# (drizzle-orm, node-postgres, better-auth, @orpc, hono, …) plus the Bun runtime
# into one executable. --minify for size; no sourcemaps in the runtime.
RUN bun build --compile --minify ./src/index.ts --outfile /tmp/heimdallone-server

# ── runtime: distroless/cc (glibc) — smallest safe glibc base for the binary ──
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime
LABEL org.opencontainers.image.title="Heimdallone v2 server" \
      org.opencontainers.image.source="https://github.com/kareemschultz/heimdallone-v2" \
      org.opencontainers.image.description="Heimdallone v2 API/server (oRPC + Hono on Bun, compiled)"
COPY --from=build /tmp/heimdallone-server /usr/local/bin/heimdallone-server
# Standard distroless nonroot user (numeric, no /etc/passwd lookup needed).
USER 65532:65532
ENV PORT=3000 NODE_ENV=production
EXPOSE 3000
# No in-image HEALTHCHECK: distroless has no shell/curl. /health is probed
# externally (compose/orchestrator/Pangolin → GET /health, like the v1 deploy).
ENTRYPOINT ["/usr/local/bin/heimdallone-server"]
