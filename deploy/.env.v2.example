# Heimdallone v2 side-by-side stack — copy to deploy/.env.v2 (gitignored) and fill
# in REAL values on the host. NEVER commit the filled file. Secrets come from
# Infisical / the host, not the repo.

# Image tag built by the Docker Images (v2) workflow, e.g. sha-7695938
TAG=latest
GHCR_OWNER=kareemschultz

# v2 database — the already-loaded, validated cutover DB (NOT karetech_erp, NOT dev).
DATABASE_URL=postgres://USER:PASSWORD@postgres-central:5432/heimdallone_v2_prod

# Auth / CORS — match the public hostnames the v2 app will serve at cutover.
BETTER_AUTH_SECRET=__set_on_host__
BETTER_AUTH_URL=https://api.heimdallone.com
CORS_ORIGIN=https://app.heimdallone.com

# Platform owner (cross-tenant). Set to the migrated owner user id at cutover.
PLATFORM_ADMIN_USER_ID=

# Google OAuth (allowed like v1). Values live in Infisical, not here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
